# Local LLM Stack - llama.cpp Configuration
# See CONFIG_GUIDE.md for detailed tuning

# ============================================================
# Model Configuration
# ============================================================
# Path to model file (download from ./models/download-qwen.sh)
MODEL_PATH="$HOME/models/qwen2.5-coder-7b-instruct-q4_k_m.gguf"
MODEL_NAME="qwen2.5-coder"

# Server Configuration
HOST="0.0.0.0"
PORT="8000"

# ============================================================
# GPU Layers - CRITICAL SETTING (tune for YOUR VRAM)
# ============================================================
# Rule: More GPU layers = faster but needs more VRAM
#
# VRAM     | 7B Model  | 14B Model | 32B Model
# --------|-----------|-----------|-----------
# 6GB     | 12-15     | can't     | can't
# 8GB     | 20-28     | can't    | can't  
# 10GB    | 35        | 15-20    | can't
# 12GB    | all       | 30-35    | can't
# 16GB+   | all       | all      | 20-30
#
# If OOM/crash: LOWER this value
# If too slow: INCREASE this value
GPU_LAYERS="0"  # 0=CPU only (safe fallback)

# ============================================================
# Context Size - CRITICAL FOR CODING
# ============================================================
# Larger = more context memory but slower
# 16384 = good default for coding (fits in RAM)
# 32768 = larger context (needs more VRAM/RAM)
# 8192 = fast but limited context
CONTEXT_SIZE="16384"

# ============================================================
# CPU Threads
# ============================================================
# Set to number of CPU threads (Ryzen 5600T = 12 threads)
THREADS="12"

# ============================================================
# Memory Optimization
# ============================================================
# KV cache quantization (saves VRAM)
CACHE_TYPE_K="q4_0"
CACHE_TYPE_V="q4_0"

# ============================================================
# Batch Processing
# ============================================================
BATCH_SIZE="512"
UBATCH_SIZE="512"

# ============================================================
# Performance Tuning
# ============================================================
# Flash attention (auto/enable recommended)
FLASH_ATTN="auto"

# Memory mapping (faster loading)
MMAP="1"

# Continuous batching (better responsiveness)
CONT_BATCHING="1"

# Parallel processing
PARALLEL="1"

# ============================================================
# Sampling (can override per request)
# ============================================================
TEMPERATURE="0.7"
TOP_K="40"
TOP_P="0.95"