# Local LLM Stack - llama.cpp Configuration
# Optimized settings for RTX 5050 + 64GB RAM setup

# Model Configuration (use 7b for 8GB VRAM, 14b for 12GB+)
MODEL_PATH="$HOME/models/qwen2.5-coder-7b-instruct-q4_k_m.gguf"
MODEL_NAME="qwen2.5-coder"

# Server Configuration
HOST="0.0.0.0"
PORT="8000"

# Performance Settings (RTX 5050 8GB VRAM)
# GPU layers: 0=CPU only (works), 20+=GPU (needs more VRAM)
GPU_LAYERS="0"  # CPU only for RTX 5050 8GB

# Context window - balance between capability and memory usage
CONTEXT_SIZE="16384"

# CPU threads (Ryzen 5600T has 6 cores/12 threads)
THREADS="12"

# Memory Optimization
# KV cache quantization to save VRAM
CACHE_TYPE_K="q4_0"
CACHE_TYPE_V="q4_0"

# Batch Processing
# Keep moderate for single-user setup
BATCH_SIZE="512"
UBATCH_SIZE="512"

# Performance Tuning
# Flash attention for better performance
FLASH_ATTN="auto"

# Memory mapping for faster model loading
MMAP="1"

# Additional Options
# Enable continuous batching for better responsiveness
CONT_BATCHING="1"

# Parallel processing
PARALLEL="1"

# Temperature and sampling (can be overridden per request)
TEMPERATURE="0.7"
TOP_K="50"
TOP_P="0.95"

# Logging
LOG_LEVEL="INFO"