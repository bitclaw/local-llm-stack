# Local LLM Stack - Environment Configuration Template
# Copy this file to .env and customize for your setup

# =============================================================================
# Model Configuration
# =============================================================================

# Path to your GGUF model file
# Example: "/home/user/models/qwen2.5-coder-14b-instruct-q4_k_m.gguf"
MODEL_PATH="$HOME/models/qwen2.5-coder-14b-instruct-q4_k_m.gguf"

# Model name identifier (used in API responses)
MODEL_NAME="qwen2.5-coder"

# =============================================================================
# Server Configuration
# =============================================================================

# Server host (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
HOST="0.0.0.0"

# Server port
PORT="8000"

# =============================================================================
# Performance Settings
# =============================================================================

# GPU layers to offload (adjust based on your GPU VRAM)
# RTX 5050 (8GB): start with 35, increase if stable
# RTX 4060 (8GB): 30-40
# RTX 4070 (12GB): 40-50
# RTX 4080+ (16GB+): 50-60
GPU_LAYERS="35"

# Context window size (balance between capability and memory)
# 4096 = minimal, 16384 = recommended, 32768 = large (if you have enough VRAM)
CONTEXT_SIZE="16384"

# CPU threads (set to your CPU thread count, use `nproc` to check)
# Ryzen 5600T: 12, Intel i5-12400: 12, etc.
THREADS="12"

# =============================================================================
# Memory Optimization
# =============================================================================

# KV cache quantization (reduces VRAM usage)
# Options: f16, q8_0, q4_0, q4_1
# q4_0 is recommended for VRAM-constrained setups
CACHE_TYPE_K="q4_0"
CACHE_TYPE_V="q4_0"

# Batch processing settings
BATCH_SIZE="512"
UBATCH_SIZE="512"

# =============================================================================
# Advanced Performance Tuning
# =============================================================================

# Flash attention (0=disabled, 1=enabled)
# Enable for better performance on supported hardware
FLASH_ATTN="1"

# Memory mapping (0=disabled, 1=enabled)
# Enables faster model loading
MMAP="1"

# Continuous batching (0=disabled, 1=enabled)
# Improves responsiveness for multiple requests
CONT_BATCHING="1"

# Parallel processing (0=disabled, 1=enabled)
PARALLEL="1"

# =============================================================================
# Default Sampling Parameters
# =============================================================================
# These can be overridden per API request

# Temperature (0.0-2.0, lower = more focused, higher = more creative)
TEMPERATURE="0.7"

# Top-K sampling (limit to top K tokens)
TOP_K="50"

# Top-P sampling (nucleus sampling, 0.0-1.0)
TOP_P="0.95"

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level (ERROR, WARN, INFO, DEBUG)
LOG_LEVEL="INFO"

# =============================================================================
# Hardware Profile Examples
# =============================================================================

# Uncomment and modify one of these profiles instead of individual settings above

# --- Low-end Profile (8-16GB RAM, 6-8GB VRAM) ---
# GPU_LAYERS="25"
# CONTEXT_SIZE="8192"
# CACHE_TYPE_K="q4_0"
# CACHE_TYPE_V="q4_0"
# BATCH_SIZE="256"

# --- Mid-range Profile (32-64GB RAM, 8-12GB VRAM) ---
# GPU_LAYERS="35"
# CONTEXT_SIZE="16384"
# CACHE_TYPE_K="q4_0"
# CACHE_TYPE_V="q4_0"
# BATCH_SIZE="512"

# --- High-end Profile (64GB+ RAM, 16GB+ VRAM) ---
# GPU_LAYERS="50"
# CONTEXT_SIZE="32768"
# CACHE_TYPE_K="q8_0"
# CACHE_TYPE_V="q8_0"
# BATCH_SIZE="1024"

# =============================================================================
# Claude Code Integration
# =============================================================================
# Set these environment variables for Claude Code/OpenCode integration:
#
# export OPENAI_API_BASE=http://localhost:8000/v1
# export OPENAI_API_KEY=sk-local
#
# Then configure your client to use:
# - Provider: OpenAI-compatible
# - Base URL: http://localhost:8000/v1
# - Model: qwen2.5-coder (or whatever MODEL_NAME you set above)